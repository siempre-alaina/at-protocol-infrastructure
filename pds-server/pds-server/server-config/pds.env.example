# Copy to pds.env and fill in your own values.
# Generate the three secrets below with:
#   openssl rand --hex 16   # PDS_ADMIN_PASSWORD
#   openssl rand --hex 32   # PDS_JWT_SECRET
#   openssl rand --hex 32   # PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX
#
# WARNING: PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX controls your did:plc
# identity. Anyone who has it can permanently take over your DID. Back it up
# offline and never commit it.

PDS_HOSTNAME=<YOUR_PDS_HOSTNAME>
PDS_PORT=3000

PDS_DATA_DIRECTORY=/srv/pds/data
PDS_BLOBSTORE_DISK_LOCATION=/srv/pds/data/blobs

PDS_JWT_SECRET=<GENERATE_ME>
PDS_ADMIN_PASSWORD=<GENERATE_ME>
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=<GENERATE_ME>

PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network

PDS_SERVICE_HANDLE_DOMAINS=.<YOUR_PDS_HOSTNAME>

LOG_ENABLED=true
