[Unit]
Description=AT Protocol Relay
Documentation=https://github.com/siempre-alaina/at-protocol
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/srv/relay/app
ExecStart=/srv/relay/app/relay --config /etc/relay/relay.yaml --db --json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment file
EnvironmentFile=/etc/relay/relay.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/relay/data
ReadOnlyPaths=/etc/relay

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
